# EditorConfig helps maintain consistent coding styles
root = true

[*]
charset = utf-8
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gradle.kts]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.toml]
indent_style = space
indent_size = 2
